#!/bin/sh
# The "phone shell": a Wayland kiosk compositor running the home screen app.
# ponytail: runs as root for the prototype; add a user + seatd group before shipping.
# tty1 respawn starts in parallel with openrc: wait for udev (input devices) and seatd
while [ ! -e /run/openrc/started/udev-trigger ] || [ ! -e /run/openrc/started/seatd ] || [ ! -e /dev/dri/card0 ]; do sleep 1; done
udevadm settle
export XDG_RUNTIME_DIR=/run/user/0 WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 LIBSEAT_BACKEND=seatd
mkdir -p $XDG_RUNTIME_DIR && chmod 700 $XDG_RUNTIME_DIR
exec cage -s -- /usr/local/bin/home
